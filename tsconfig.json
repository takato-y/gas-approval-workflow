{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "types": ["google-apps-script"],
    "strict": true,
    "noImplicitReturns": true,
    "noEmitOnError": true,
    "removeComments": false,
    "rootDir": "src",
    "outDir": "dist",
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"]
}
