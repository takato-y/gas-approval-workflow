{
  "name": "gas-approval-workflow",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Google Apps Script による経費・備品購入申請の承認フロー（ポートフォリオ）",
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/copy-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "sample-data": "node tools/generate-sample-data.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/google-apps-script": "2.0.15",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
